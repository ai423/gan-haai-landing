{
  "name": "aman-opportunity-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "מערכת הזדמנויות מכירה חוצת-קבוצה לאמן מחשוב (Aman Group)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/init.js --force && node src/db/seed.js",
    "scrape:group": "node src/cli.js scrape-group",
    "scrape:clients": "node src/cli.js scrape-clients",
    "research": "node src/cli.js research",
    "match": "node src/cli.js match",
    "report": "node src/cli.js report",
    "pipeline": "node src/cli.js pipeline",
    "demo": "node src/db/demo-signals.js",
    "demo:clear": "node src/db/demo-signals.js --clear"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  }
}
