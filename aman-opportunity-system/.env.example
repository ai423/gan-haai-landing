# ── מפתח Claude API (חובה למחקר ולסיכום המנכ"ל) ─────────────────────────
# להשגה: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# מודל. ברירת מחדל: claude-opus-5
AMAN_MODEL=claude-opus-5

# רמת מאמץ למחקר: low | medium | high | xhigh | max
AMAN_EFFORT=high

# ── שרת ─────────────────────────────────────────────────────────────────
PORT=3000

# ── הגנת סיסמה ──────────────────────────────────────────────────────────
# חובה בכל פריסה לכתובת ציבורית. בהרצה מקומית אפשר להשאיר ריק.
# המערכת תסרב לעלות בסביבת ייצור בלי סיסמה.
APP_USER=aman
APP_PASSWORD=
# עקיפה מפורשת, רק אם המערכת כבר מאחורי VPN או רשת פנימית:
# ALLOW_NO_AUTH=true

# ── תזמון ───────────────────────────────────────────────────────────────
# ביטוי cron להרצת המחקר החודשי. ברירת מחדל: ה-1 בכל חודש ב-03:00
RESEARCH_CRON=0 3 1 * *
# אזור זמן לתזמון
TZ=Asia/Jerusalem
# הפעלת התזמון האוטומטי עם עליית השרת (true/false)
ENABLE_SCHEDULER=true

# ── סריקה ───────────────────────────────────────────────────────────────
AMAN_GROUP_URL=https://www.aman-global.com/
SCRAPE_USER_AGENT=AmanOpportunityBot/1.0 (+internal sales-intelligence tool)
SCRAPE_DELAY_MS=1200
SCRAPE_TIMEOUT_MS=25000
# כיבוד robots.txt (מומלץ להשאיר true)
RESPECT_ROBOTS=true
